{
  "name": "n8n-nodes-apivault-walmart-seller-analyzer",
  "version": "0.1.0",
  "description": "n8n community node for Walmart Seller Analyzer — backed by the Apify Actor apivault_labs/walmart-seller-revenue-product-opportunity-analyzer. No login. Pay-as-you-go via Apify.",
  "license": "MIT",
  "homepage": "https://apify.com/apivault_labs/walmart-seller-revenue-product-opportunity-analyzer",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "walmart-seller-analyzer",
    "apify",
    "no-code",
    "automation",
    "data-analysis",
    "workflow-automation"
  ],
  "author": {
    "name": "apivault_labs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apivault-labs/n8n-nodes-apivault-walmart-seller-analyzer.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && copyfiles \"nodes/**/*.svg\" dist",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ApifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WalmartSellerAnalyzer/WalmartSellerAnalyzer.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "copyfiles": "^2.4.1",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}